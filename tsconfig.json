{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@turnia/db": ["packages/db/src"],
      "@turnia/types": ["packages/types/src"],
      "@turnia/i18n": ["packages/i18n/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
