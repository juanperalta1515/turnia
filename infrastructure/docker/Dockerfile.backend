# docker/Dockerfile.backend
FROM node:20-alpine AS builder

WORKDIR /app

# Copy monorepo config
COPY package*.json tsconfig.json ./
COPY packages/db/package*.json ./packages/db/
COPY apps/api-backend/package*.json ./apps/api-backend/

# Install dependencies
RUN npm ci

# Copy source files
COPY packages/db ./packages/db
COPY apps/api-backend ./apps/api-backend

# Generate Prisma Client
RUN npm run db:generate

# Build backend
RUN npm run build --workspace=apps/api-backend

# --- Production Runner ---
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy built code and dependencies
COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/db ./packages/db
COPY --from=builder /app/apps/api-backend/dist ./apps/api-backend/dist
COPY --from=builder /app/apps/api-backend/package*.json ./apps/api-backend/

EXPOSE 4000

CMD ["node", "apps/api-backend/dist/main.js"]
